# SmartGuard with Docker Compose — copy to ".env" next to docker-compose.yml and edit.
#   cp docker/env.example .env
# Guide: docs/docker.md (English) · docs/docker.es.md (español)

# --- Secrets (required). Generate each one with:  openssl rand -hex 32 ------------------------
# Token to open the dashboard and use the admin API (at least 32 characters).
ADMIN_TOKEN=
# Shared by Nginx and SmartGuard for the decision request (24-128 letters and digits).
DECISION_SHARED_SECRET=

# --- Your site ------------------------------------------------------------------------------
# Domains served by Nginx (space-separated). "_" answers any host.
SERVER_NAME=_
# Where Nginx sends the requests SmartGuard allows. A service name of this Compose project,
# or any URL the nginx container can reach (http://172.30.77.1:8080 = the Docker host, http://10.0.0.5).
APP_UPSTREAM=http://wordpress:80
# Port published on the Docker host for the site.
HTTP_PORT=80
# Port of the dashboard, published only on 127.0.0.1 of the Docker host.
DASHBOARD_PORT=3100

# --- Mode -----------------------------------------------------------------------------------
# true  = AUDIT: SmartGuard and the Nginx rules only log what they would block. Start here.
# false = ENFORCE: block for real. After changing it:  docker compose up -d
AUDIT_MODE=true

# --- Allowlists (comma-separated IPs, CIDRs or domains). Never by User-Agent ----------------
# Your own administration IP(s): never blocked.
ADMIN_ALLOWLIST=
# Services that call your site (payment gateways, monitors).
SERVICE_ALLOWLIST=
TRUSTED_NETWORKS=
# Destination hosts SmartGuard must not score (internal APIs, panels).
ALLOW_HOSTS=

# --- Demo WordPress (only used with: docker compose --profile demo) -------------------------
WORDPRESS_DB_PASSWORD=change-me
