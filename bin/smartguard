#!/usr/bin/env bash
# =============================================================================
# smartguard — CLI de administración (punto 84). Habla con la API local (127.0.0.1) usando el
# ADMIN_TOKEN de /etc/smartguard/smartguard.env (por eso requiere sudo).
# =============================================================================
set -Eeuo pipefail
LIB=/opt/smartguard/scripts/lib
# shellcheck source=../scripts/lib/common.sh
. "$LIB/common.sh"
# shellcheck source=../scripts/lib/nginx-gen.sh
. "$LIB/nginx-gen.sh"

usage() {
  cat <<'EOF'
Uso: sudo smartguard <comando> [args]

  status                      Estado del servicio, modo, Redis, bans y tráfico
  ip <IP>                     Explica el score/estado de una IP (¿por qué fue bloqueada?)
  ban <IP> [duración] [motivo]   Ban manual (duración: 900, 15m, 1h, 2d; por defecto 1h)
  unban <IP> [--keep-score]   Desbloquea: ban de IP y de huellas, nftables, Cloudflare y (por
                              defecto) resetea score/motivos para que no se re-banee al instante
  allow <valor> [tipo] [nota] Allowlist de CLIENTES. valor = IP, CIDR, dominio (app.x.com → sus IPs)
                              o subdominios (*.x.com → verificación FCrDNS). Si es una IP, la desbloquea.
                              tipo: ADMIN_ALLOWLIST (defecto) | SERVICE_ALLOWLIST | TRUSTED_NETWORK
  allow-host <dominio> [nota] Exime un sitio/subdominio DESTINO (p. ej. api.x.com o *.dev.x.com)
  unallow <valor>             Quita de la allowlist (clientes o hosts)
  allowlist                   Muestra la allowlist (estática, dinámica y dominios resueltos)
  lookup <valor>              ¿Dónde está? IP/CIDR/dominio/*.dominio/URL: en qué lista, si está bloqueada, score
  bans [--audit]              Lista de bans activos (o would-bans de AUDIT)
  events [N]                  Últimos N eventos de seguridad (por defecto 30)
  report                      Informe de AUDIT: qué se habría bloqueado y posibles falsos positivos
  rules reload                Recarga rules.yaml / sites.yaml / bots.yaml sin reiniciar
  audit on|off|status         AUDIT (solo registra) / ENFORCE (bloquea): SmartGuard + reglas Nginx
  killswitch on|off           Emergencia: Nginx deja de consultar a SmartGuard (fail-open total)
  nginx-sync                  Regenera allowlist.conf y secret.conf desde el .env y recarga Nginx
  nginx-enable                Reactiva SmartGuard en Nginx tras rollback-nginx.sh --disable
  fw-sync                     Sincroniza sets nftables (trusted, cloudflare)
  protect <sitio>... [--dry-run] [--yes]
                              Añade la protección a uno o varios sitios de Nginx: lee su vhost
                              (/etc/nginx/sites-enabled/<sitio>.conf), inserta los include de
                              SmartGuard donde corresponde, comprueba con nginx -t y recarga.
                              Enseña los cambios antes de aplicarlos; si Nginx los rechaza, los deshace.
  unprotect <sitio>... [--dry-run] [--yes]
                              Quita los include de SmartGuard de esos sitios
  reprotect                   Repone la protección en los sitios registrados con «protect» si su
                              vhost la ha perdido (lo lanza systemd solo cuando CloudPanel reescribe
                              un vhost). «protected» lista los sitios registrados.
  backup [archivo.tar.gz]     Copia de seguridad completa: configuración (/etc/smartguard), fragmentos de
                              Nginx, listas guardadas en Redis (lista blanca, bloqueos, bots, redes), los
                              vhosts protegidos y una copia de todo /etc/nginx. Por defecto en /root.
  restore <archivo.tar.gz> [--keep-env] [--yes]
                              Restaura una copia en este servidor (SmartGuard debe estar instalado):
                              configuración, fragmentos de Nginx y listas; después repone la protección
                              en los sitios registrados que existan aquí. --keep-env conserva el
                              smartguard.env de este servidor (Redis, token y secreto propios).
  update [--check] [--force] [--yes]
                              Consulta GitHub y, SOLO si hay cambios, descarga e instala la nueva
                              versión conservando tu configuración. --check: solo avisa.
                              --force: reinstala aunque no haya cambios. Revertir: update.sh --revert
  version                     Versión y commit instalados
  logs                        journalctl -u smartguard -f
EOF
}

require_root
[ -r "$SG_ENV" ] || die "No se puede leer $SG_ENV"
PORT=$(env_get PORT); PORT=${PORT:-3100}
API="http://127.0.0.1:$PORT"
NODE=$(node_bin)

HDR=$(mktemp); chmod 600 "$HDR"; trap 'rm -f "$HDR"' EXIT
printf 'Authorization: Bearer %s\n' "$(env_get ADMIN_TOKEN)" >"$HDR"

api() { # api METHOD PATH [JSON]
  local m=$1 p=$2 body=${3:-}
  if [ -n "$body" ]; then
    curl -sS --max-time 10 -X "$m" -H @"$HDR" -H 'content-type: application/json' --data-binary "$body" "$API$p"
  else
    curl -sS --max-time 10 -X "$m" -H @"$HDR" "$API$p"
  fi
}
pretty() { "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.stringify(JSON.parse(s),null,2))}catch{console.log(s)}})'; }
json() { "$NODE" -e 'const a=process.argv.slice(1);const o={};for(let i=0;i<a.length;i+=2){let v=a[i+1];if(v==="true")v=true;else if(v==="false")v=false;if(v!=="")o[a[i]]=v}console.log(JSON.stringify(o))' "$@"; }
valid_ip() { [[ "$1" =~ ^[0-9a-fA-F:.]{2,45}(/[0-9]{1,3})?$ ]] || die "IP/CIDR inválida: $1"; }
valid_allow() { [[ "$1" =~ ^([0-9a-fA-F:.]{2,45}(/[0-9]{1,3})?|(\*\.)?[A-Za-z0-9.-]{3,253}|https?://[^[:space:]]{3,2000})$ ]] || die "Valor inválido (IP, CIDR, dominio, *.dominio o URL): $1"; }

# Commit de GitHub instalado (lo escribe update.sh/install.sh); "desconocido" en instalaciones antiguas
installed_commit() { cat "$SG_OPT/COMMIT" 2>/dev/null || echo desconocido; }

# Registro de sitios protegidos ($SG_PROTECTED): protect los añade, unprotect los quita.
register_sites() { # register_sites protect|unprotect sitio...
  local action=$1 s tmp; shift
  tmp=$(mktemp)
  { [ -f "$SG_PROTECTED" ] && cat "$SG_PROTECTED"; true; } >"$tmp"
  for s in "$@"; do
    s=${s%.conf}
    grep -vxF "$s" "$tmp" >"$tmp.n" || true; mv "$tmp.n" "$tmp"
    [ "$action" = protect ] && echo "$s" >>"$tmp"
  done
  sort -u "$tmp" | write_file "$SG_PROTECTED" 0644
  rm -f "$tmp"
}

current_enforce() { grep -A1 'sg_nginx_enforce' "$NGX_SG/mode.conf" 2>/dev/null | grep -oE 'default [01]' | grep -oE '[01]' || echo 0; }
current_ks() { grep -A1 'sg_killswitch' "$NGX_SG/mode.conf" 2>/dev/null | grep -oE 'default [01]' | grep -oE '[01]' || echo 0; }

apply_nginx_mode() { # $1 audit|enforce  $2 on|off (killswitch)
  local bak; bak=$(mktemp -d)
  cp -a "$NGX_SG/mode.conf" "$NGX_SG/limits-mode.conf" "$bak/" 2>/dev/null || true
  gen_mode_conf "$1" "$2" | write_file "$NGX_SG/mode.conf" 0644
  gen_limits_mode_conf "$1" | write_file "$NGX_SG/limits-mode.conf" 0644
  if ! nginx_safe_reload; then
    cp -a "$bak/"*.conf "$NGX_SG/"; rm -rf "$bak"
    die "Nginx rechazó el cambio de modo; restaurado el anterior."
  fi
  rm -rf "$bak"
}

cmd=${1:-help}; shift || true
case "$cmd" in
  status)
    systemctl --no-pager --lines=0 status smartguard | head -n 3 || true
    echo "--- versión $("$NODE" -p "require('$SG_OPT/package.json').version" 2>/dev/null || echo '?') ($(installed_commit | cut -c1-7))"
    echo "--- health"; curl -sS --max-time 3 "$API/health" | pretty || warn "SmartGuard no responde (Nginx sigue funcionando en fail-open)"
    echo "--- Nginx: reglas nuevas=$([ "$(current_enforce)" = 1 ] && echo ENFORCE || echo AUDIT) · killswitch=$([ "$(current_ks)" = 1 ] && echo ON || echo off)"
    echo "--- últimos 60 min"
    api GET "/admin/stats?minutes=60" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);const t=j.totals||{};
      console.log(`modo=${j.mode} decisiones/min=${j.requestsPerMin} IPs activas(5m)=${j.activeIps5m} bans=${j.bansActive} would-bans=${j.wouldBansActive} redis_degradado=${j.degraded}`);
      console.log(`403 SG=${t.blocked_403||0} 429 SG=${t.limited_429||0} would_block=${t.would_block||0} would_rate_limit=${t.would_rate_limit||0} php_evitado=${t.php_avoided||0} 403 nginx=${t.log_403||0} 429 nginx=${t.log_429||0}`);})' || true
    ;;

  ip)
    [ $# -ge 1 ] || die "Uso: smartguard ip <IP>"; valid_ip "$1"
    api GET "/admin/ip/$1" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);if(j.explanation){console.log(j.explanation);if(j.ban)console.log("\nBan:",JSON.stringify(j.ban,null,2))}else console.log(JSON.stringify(j,null,2))})'
    ;;

  ban)
    [ $# -ge 1 ] || die "Uso: smartguard ban <IP> [duración] [motivo]"; valid_ip "$1"
    ip=$1; dur=${2:-1h}; shift; shift || true; reason="${*:-cli}"
    [[ "$dur" =~ ^[0-9]{1,7}[smhdw]?$ ]] || die "Duración inválida: $dur"
    api POST /admin/ban "$(json ip "$ip" duration "$dur" reason "$reason")" | pretty
    ;;

  unban)
    [ $# -ge 1 ] || die "Uso: smartguard unban <IP> [--keep-score]"; valid_ip "$1"
    q=""; [ "${2:-}" = --keep-score ] && q="?reset=false"
    api DELETE "/admin/ban/$1$q" | pretty
    ;;

  allow)
    [ $# -ge 1 ] || die "Uso: smartguard allow <IP|CIDR|dominio|*.dominio> [tipo] [nota]"; valid_allow "$1"
    value=$1; type=${2:-ADMIN_ALLOWLIST}; shift; shift || true; note="${*:-cli}"
    case "$type" in ADMIN_ALLOWLIST|SERVICE_ALLOWLIST|TRUSTED_NETWORK) ;; *) die "tipo inválido: $type" ;; esac
    api POST /admin/allow "$(json value "$value" type "$type" target client note "$note")" | pretty
    log "Recuerda: 'smartguard nginx-sync' para eximirla también de los límites de Nginx (IPs y dominios exactos)."
    ;;

  allow-host)
    [ $# -ge 1 ] || die "Uso: smartguard allow-host <dominio|*.dominio> [nota]"; valid_allow "$1"
    value=$1; shift; note="${*:-cli}"
    api POST /admin/allow "$(json value "$value" type SERVICE_ALLOWLIST target host note "$note")" | pretty
    log "Ese host ya no se puntúa en SmartGuard. Si es un vhost propio, lo ideal es NO incluir los snippets de SmartGuard en él."
    ;;

  unallow)
    [ $# -ge 1 ] || die "Uso: smartguard unallow <valor>"; valid_allow "$1"
    api DELETE "/admin/allow/$("$NODE" -p 'encodeURIComponent(process.argv[1])' "$1")" | pretty
    ;;

  allowlist)
    api GET /admin/allow | pretty
    ;;

  lookup)
    [ $# -ge 1 ] || die "Uso: smartguard lookup <IP|CIDR|dominio|*.dominio|URL>"; valid_allow "$1"
    api GET "/admin/lookup?value=$("$NODE" -p 'encodeURIComponent(process.argv[1])' "$1")" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);
      if(j.code){console.log(j.message);process.exit(1)}
      console.log(`${j.normalized}${j.key&&j.key!==j.normalized?" (clave "+j.key+")":""}`);
      if(j.isCloudflare)console.log("  ⚠ IP de Cloudflare: no bloquear");
      if(j.allowlisted){console.log("  ✔ YA está en la lista blanca:");for(const m of j.allowlist)console.log(`     - ${m.list} [${m.value}] origen=${m.source} (${m.matchedBy}${m.detail?": "+m.detail:""})${m.note?" nota: "+m.note:""}`)}
      if(j.ban)console.log(`  ✖ BLOQUEADA hasta ${new Date(j.ban.expiresAt).toISOString()} — ${j.ban.reason}`);
      if(!j.ban&&j.auditBan)console.log(`  ~ En AUDIT se bloquearía hasta ${new Date(j.auditBan.expiresAt).toISOString()}`);
      if(j.fingerprintBans)console.log(`  ✖ ${j.fingerprintBans} bloqueo(s) por huella IP+UA`);
      if(!j.allowlisted&&!j.ban&&!j.auditBan&&!j.fingerprintBans)console.log("  · No está en ninguna lista");
      if(j.score!==null)console.log(`  score: ${j.score}`)})'
    ;;

  bans)
    q="audit=false"; [ "${1:-}" = --audit ] && q="audit=true"
    api GET "/admin/bans?$q&limit=200" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);
      console.log(`${j.audit?"WOULD-BANS (AUDIT)":"BANS ACTIVOS"}: ${j.total}`);
      for(const b of j.items)console.log(`${b.key.padEnd(40)} score=${String(b.score).padEnd(7)} x${b.banCount} ${b.scope} ${b.source.padEnd(9)} hasta ${new Date(b.expiresAt).toISOString()}  ${b.reason}`)})'
    ;;

  events)
    n=${1:-30}; [[ "$n" =~ ^[0-9]{1,4}$ ]] || die "N inválido"
    api GET "/admin/events?limit=$n" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{for(const e of JSON.parse(s))console.log(`${new Date(e.timestamp).toISOString()} ${String(e.action||"").padEnd(18)} ${e.ip.padEnd(39)} ${e.method} ${e.uri} [${e.category} +${e.scoreDelta}] ${e.reason}`)})'
    ;;

  report)
    echo "=== Informe AUDIT (últimas 24 h) ==="
    api GET "/admin/stats?minutes=1440" | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);const t=j.totals||{};
      console.log(`Decisiones: ${t.requests||0} · WOULD_BLOCK: ${t.would_block||0} · WOULD_RATE_LIMIT: ${t.would_rate_limit||0} · would-bans: ${t.would_ban||0} · PHP evitado: ${t.php_avoided||0}`);
      console.log("\nTop reglas:");for(const r of j.topRules)console.log(`  ${String(r.score).padStart(6)}  ${r.member}`);
      console.log("\nTop rutas de ataque:");for(const r of j.topPaths)console.log(`  ${String(r.score).padStart(6)}  ${r.member}`);
      console.log("\nTop IPs (puntos):");for(const r of j.topIps)console.log(`  ${String(r.score).padStart(6)}  ${r.member}`);})' || true
    echo; "$0" bans --audit || true
    echo; echo "=== Log Nginx: reglas nuevas (nb) y límites en dry-run (posibles falsos positivos) ==="
    "$NODE" - "$SG_LOGDIR" <<'JS'
const fs = require('fs'), path = require('path');
const dir = process.argv[2];
const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter(f => /^access\.json(\.1)?$/.test(f)).map(f => path.join(dir, f)) : [];
const nb = new Map(), nbPaths = new Map(), dry = new Map(), dryUa = new Map(), ua403 = new Map();
const inc = (m, k, n = 1) => m.set(k, (m.get(k) || 0) + n);
for (const f of files) for (const line of fs.readFileSync(f, 'utf8').split('\n')) {
  if (!line) continue; let r; try { r = JSON.parse(line); } catch { continue; }
  if (r.nb) { inc(nb, r.nb); inc(nbPaths, `${r.nb}  ${r.p}`); }
  if (r.lr === 'REJECTED_DRY_RUN' || r.lc === 'REJECTED_DRY_RUN') { inc(dry, r.ip); inc(dryUa, `${r.ip}  ${String(r.ua).slice(0, 60)}`); }
  if (r.st === 403 && /guzzle/i.test(r.ua || '')) inc(ua403, `${r.ip}  ${r.ua}`);
}
const top = (m, n = 15) => [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);
console.log('Reglas Nginx nuevas que habrían bloqueado (nb):'); for (const [k, v] of top(nb)) console.log(`  ${String(v).padStart(6)}  ${k}`);
console.log('\nRutas por regla (revisa que ninguna sea legítima):'); for (const [k, v] of top(nbPaths, 30)) console.log(`  ${String(v).padStart(6)}  ${k}`);
console.log('\nIPs que habrían recibido 429 de Nginx (¿NAT/oficina/servicio? → allowlist):'); for (const [k, v] of top(dryUa, 20)) console.log(`  ${String(v).padStart(6)}  ${k}`);
console.log('\nGuzzleHttp bloqueado por tu lista de bots (¿integraciones?):'); for (const [k, v] of top(ua403, 10)) console.log(`  ${String(v).padStart(6)}  ${k}`);
JS
    ;;

  rules)
    [ "${1:-}" = reload ] || die "Uso: smartguard rules reload"
    api POST /admin/rules/reload | pretty
    ;;

  audit)
    case "${1:-status}" in
      status) api GET /admin/mode | pretty; echo "Nginx reglas nuevas: $([ "$(current_enforce)" = 1 ] && echo ENFORCE || echo AUDIT)" ;;
      on)
        api POST /admin/mode '{"audit":true}' | pretty
        env_set AUDIT_MODE true
        apply_nginx_mode audit "$([ "$(current_ks)" = 1 ] && echo on || echo off)"
        ok "AUDIT activado: SmartGuard y las reglas Nginx nuevas solo registran."
        ;;
      off)
        warn "ENFORCE: SmartGuard bloqueará (403), los límites Nginx devolverán 429 y las reglas Nginx nuevas 403."
        warn "¿Revisaste 'smartguard report' tras 24–72 h en AUDIT y añadiste tus IPs/servicios a la allowlist?"
        confirm "¿Activar ENFORCE?" || die "Cancelado."
        api POST /admin/mode '{"audit":false}' | pretty
        env_set AUDIT_MODE false
        apply_nginx_mode enforce "$([ "$(current_ks)" = 1 ] && echo on || echo off)"
        ok "ENFORCE activado. Volver atrás: sudo smartguard audit on"
        ;;
      *) die "Uso: smartguard audit on|off|status" ;;
    esac
    ;;

  killswitch)
    mode=$([ "$(current_enforce)" = 1 ] && echo enforce || echo audit)
    case "${1:-}" in
      on) apply_nginx_mode "$mode" on; warn "KILLSWITCH ON: Nginx ya no consulta a SmartGuard (las reglas Nginx siguen activas)." ;;
      off) apply_nginx_mode "$mode" off; ok "Killswitch desactivado: Nginx vuelve a consultar a SmartGuard." ;;
      *) die "Uso: smartguard killswitch on|off" ;;
    esac
    ;;

  nginx-sync)
    extra=$(api GET /admin/allow 2>/dev/null | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{for(const e of JSON.parse(s).dynamic||[])if((e.target||"client")==="client")console.log(e.value||e.cidr)}catch{}})' || true)
    bak=$(mktemp -d); cp -a "$NGX_SG/allowlist.conf" "$NGX_SG/secret.conf" "$bak/" 2>/dev/null || true
    gen_allowlist_conf "$extra" | write_file "$NGX_SG/allowlist.conf" 0644
    gen_secret_conf | write_file "$NGX_SG/secret.conf" 0600 root:root
    if ! nginx_safe_reload; then cp -a "$bak/"*.conf "$NGX_SG/"; rm -rf "$bak"; die "Restaurado el estado anterior."; fi
    rm -rf "$bak"
    if command -v nft >/dev/null && nft list table inet smartguard >/dev/null 2>&1; then "$SG_FWSYNC" || true; fi
    ;;

  nginx-enable)
    if [ -d "$NGX_SG/disabled-originals" ]; then
      cp -a "$NGX_SG/disabled-originals/"*.conf "$NGX_SG/"
    else
      for f in server.conf auth.conf auth-php.conf static-log.conf; do install -m 0644 "$SG_OPT/nginx/smartguard/$f" "$NGX_SG/$f"; done
    fi
    nginx_safe_reload && rm -rf "$NGX_SG/disabled-originals" && ok "SmartGuard reactivado en Nginx"
    ;;

  fw-sync) "$SG_FWSYNC" ;;

  protect|unprotect)
    dry=false; sites=()
    for a in "$@"; do
      case "$a" in
        --dry-run) dry=true ;;
        --yes|-y) ASSUME_YES=true ;;
        -*) die "Uso: smartguard $cmd <sitio>... [--dry-run] [--yes]" ;;
        *) sites+=("$a") ;;
      esac
    done
    [ ${#sites[@]} -ge 1 ] || die "Uso: smartguard $cmd <sitio>... [--dry-run] [--yes]   (sitio = nombre del vhost, p. ej. tienda.com)"
    tool=$SG_OPT/dist/nginx/vhost-cli.js
    [ -f "$tool" ] || die "Falta $tool (actualiza SmartGuard)."
    files=()
    for s in "${sites[@]}"; do
      [[ "$s" =~ ^[A-Za-z0-9._-]+$ ]] || die "Nombre de sitio inválido: $s"
      f=$NGX_DIR/sites-enabled/${s%.conf}.conf
      [ -f "$f" ] || die "No existe $f (el nombre es el de la columna «Archivo del vhost» del panel)"
      files+=("$f")
    done
    # 1) Enseñar qué se cambiaría, sin tocar nada
    rc=0; "$NODE" "$tool" "$cmd" --dry-run "${files[@]}" || rc=$?
    [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || die "No se pudieron leer los vhosts."
    if [ "$rc" -eq 2 ]; then
      # ya estaban como se pide: solo se actualiza el registro de sitios protegidos
      [ "$dry" = true ] || register_sites "$cmd" "${sites[@]}"
      ok "No hay nada que cambiar."
      exit 0
    fi
    [ "$dry" = true ] && exit 0
    echo
    if [ "$cmd" = protect ] && [ "$(current_enforce)" = 1 ]; then
      warn "SmartGuard está en ENFORCE: estos sitios empezarán a bloquear de verdad en cuanto se recargue Nginx."
    fi
    confirm "¿Aplicar estos cambios y recargar Nginx?" || die "Cancelado. No se ha cambiado nada."
    # 2) Copia de los vhosts que se van a tocar (fuera de sites-enabled) + backup completo de /etc/nginx
    backup_nginx "pre-$cmd"
    keep=$(mktemp -d)
    for f in "${files[@]}"; do cp -a "$f" "$keep/"; done
    # 3) Aplicar; si Nginx rechaza la configuración, se restauran los originales
    if ! "$NODE" "$tool" "$cmd" "${files[@]}" >/dev/null || ! nginx_safe_reload; then
      for f in "${files[@]}"; do cp -a "$keep/$(basename "$f")" "$f"; done
      rm -rf "$keep"
      nginx -t >/dev/null 2>&1 && systemctl reload nginx
      die "Nginx rechazó los cambios: se han restaurado los vhosts originales. Nada cambiado."
    fi
    rm -rf "$keep"
    register_sites "$cmd" "${sites[@]}"
    ok "Hecho. Comprueba el estado en el panel (IPs y sitios → Actualizar) y vigila la pestaña Eventos."
    if [ "$cmd" = protect ]; then
      if systemctl is-active --quiet smartguard-reprotect.path 2>/dev/null; then
        log "Si CloudPanel reescribe el vhost de uno de estos sitios, la protección se repone sola en unos segundos."
      else
        warn "CloudPanel guarda su propia copia de cada vhost: si lo editas y guardas allí, estos cambios se pierden. Actívalo para que se repongan solos: sudo systemctl enable --now smartguard-reprotect.path"
      fi
    fi
    ;;

  backup)
    out=${1:-/root/smartguard-backup-$(hostname -s 2>/dev/null || echo vps)-$(date +%Y%m%d-%H%M%S).tar.gz}
    [[ "$out" == *.tar.gz ]] || die "El archivo debe terminar en .tar.gz"
    work=$(mktemp -d); b=$work/smartguard-backup
    install -d -m 0700 "$b"
    log "Creando copia de seguridad…"
    cp -a "$SG_ETC" "$b/etc-smartguard"
    cp -a "$NGX_SG" "$b/nginx-smartguard"
    install -d "$b/nginx-http" "$b/vhosts"
    resolve_http_conf 2>/dev/null && [ -f "$NGX_CONFD" ] && cp -a "$NGX_CONFD" "$b/nginx-http/" || true
    # vhosts de los sitios protegidos, tal como están ahora (referencia para otro servidor)
    for f in "$NGX_DIR"/sites-enabled/*.conf; do
      [ -f "$f" ] && grep -qE '^[[:space:]]*include[[:space:]]+[^;#]*smartguard/' "$f" && cp -a "$f" "$b/vhosts/" || true
    done
    # todo /etc/nginx (sin los backups anteriores): para recuperar este mismo servidor
    tar czf "$b/nginx-full.tar.gz" -C /etc --exclude=nginx/backups nginx
    if curl -fsS --max-time 3 "$API/health" >/dev/null 2>&1; then
      SG_TOKEN=$(env_get ADMIN_TOKEN) SG_API=$API "$NODE" "$SG_OPT/dist/admin/state-cli.js" export "$b/state.json" \
        || warn "No se pudieron exportar las listas de Redis; la copia sigue sin ellas."
    else
      warn "SmartGuard no responde: la copia NO incluye las listas de Redis (lista blanca, bloqueos, bots, redes)."
    fi
    {
      echo "smartguard-backup 1"
      echo "fecha=$(date -Is)"
      echo "servidor=$(hostname -f 2>/dev/null || hostname)"
      echo "version=$("$NODE" -p "require('$SG_OPT/package.json').version" 2>/dev/null || echo '?')"
      echo "commit=$(installed_commit)"
    } >"$b/manifest.txt"
    (umask 077; tar czf "$out" -C "$work" smartguard-backup)
    rm -rf "$work"
    ok "Copia creada: $out ($(du -h "$out" | cut -f1))"
    warn "Contiene el ADMIN_TOKEN y el secreto de SmartGuard: guárdala como una contraseña."
    log "Para restaurarla (en este u otro servidor con SmartGuard instalado): sudo smartguard restore $out"
    ;;

  restore)
    keepenv=false; in=""
    for a in "$@"; do
      case "$a" in
        --keep-env) keepenv=true ;;
        --yes|-y) ASSUME_YES=true ;;
        -*) die "Uso: smartguard restore <archivo.tar.gz> [--keep-env] [--yes]" ;;
        *) in=$a ;;
      esac
    done
    [ -n "$in" ] && [ -f "$in" ] || die "Uso: smartguard restore <archivo.tar.gz> [--keep-env] [--yes]"
    work=$(mktemp -d)
    # solo se aceptan rutas dentro de smartguard-backup/ (nada absoluto ni con ..)
    if tar tzf "$in" | grep -qE '^/|(^|/)\.\.(/|$)' || ! tar tzf "$in" | grep -q '^smartguard-backup/manifest.txt$'; then
      rm -rf "$work"; die "El archivo no es una copia de SmartGuard válida."
    fi
    tar xzf "$in" -C "$work"
    b=$work/smartguard-backup
    head -n1 "$b/manifest.txt" | grep -qx 'smartguard-backup 1' || { rm -rf "$work"; die "Formato de copia desconocido."; }
    log "Copia: $(sed -n '2,5p' "$b/manifest.txt" | tr '\n' ' ')"
    [ "$keepenv" = true ] && log "Se conserva el smartguard.env de este servidor (--keep-env)."
    warn "Se sustituirá la configuración de SmartGuard de este servidor (reglas, sitios, bots, límites, modo) por la de la copia."
    confirm "¿Restaurar?" || { rm -rf "$work"; die "Cancelado. No se ha cambiado nada."; }
    # 1) Red de seguridad: copia de lo que hay ahora
    backup_nginx pre-restore
    before=$(mktemp -d)
    cp -a "$SG_ETC" "$before/etc-smartguard"; cp -a "$NGX_SG" "$before/nginx-smartguard"
    # 2) Configuración y fragmentos de Nginx
    if [ "$keepenv" = true ]; then cp -a "$SG_ENV" "$work/env.keep"; cp -a "$NGX_SG/secret.conf" "$work/secret.keep" 2>/dev/null || true; fi
    cp -a "$b/etc-smartguard/." "$SG_ETC/"
    cp -a "$b/nginx-smartguard/." "$NGX_SG/"
    if [ "$keepenv" = true ]; then
      cp -a "$work/env.keep" "$SG_ENV"
      # el secreto de Nginx debe ser el del .env que se queda
      [ -f "$work/secret.keep" ] && cp -a "$work/secret.keep" "$NGX_SG/secret.conf"
    fi
    chown -R root:smartguard "$SG_ETC"; chmod 0750 "$SG_ETC"; chmod 0640 "$SG_ENV"
    undo() {
      warn "Deshaciendo la restauración…"
      cp -a "$before/etc-smartguard/." "$SG_ETC/"; cp -a "$before/nginx-smartguard/." "$NGX_SG/"
      nginx -t >/dev/null 2>&1 && systemctl reload nginx
      systemctl restart smartguard || true
      rm -rf "$before" "$work"
    }
    if ! nginx_safe_reload; then undo; die "Nginx rechazó la configuración restaurada: este servidor queda como estaba."; fi
    # 3) Servicio con la configuración restaurada
    systemctl restart smartguard
    PORT=$(env_get PORT); PORT=${PORT:-3100}; API="http://127.0.0.1:$PORT"
    up=false; for _ in $(seq 1 20); do curl -fsS "$API/health" >/dev/null 2>&1 && { up=true; break; }; sleep 1; done
    if [ "$up" != true ]; then undo; die "SmartGuard no arrancó con la configuración restaurada: este servidor queda como estaba. Revisa: journalctl -u smartguard -n 50"; fi
    # 4) Listas de Redis
    if [ -f "$b/state.json" ]; then
      log "Restaurando listas (lista blanca, bloqueos manuales, bots, redes)…"
      SG_TOKEN=$(env_get ADMIN_TOKEN) SG_API=$API "$NODE" "$SG_OPT/dist/admin/state-cli.js" import "$b/state.json" \
        || warn "Algunas entradas no se pudieron restaurar (ver arriba)."
    else
      warn "La copia no incluía las listas de Redis."
    fi
    # 5) Lista blanca → Nginx, y protección de los sitios registrados que existan aquí
    "$0" nginx-sync || warn "nginx-sync falló; ejecútalo a mano."
    if [ -s "$SG_PROTECTED" ]; then
      missing=()
      while IFS= read -r s; do [ -f "$NGX_DIR/sites-enabled/$s.conf" ] || missing+=("$s"); done <"$SG_PROTECTED"
      "$0" reprotect || warn "No se pudo reponer la protección en algún sitio."
      [ ${#missing[@]} -eq 0 ] || warn "Sitios registrados que no existen en este servidor (créalos en CloudPanel y ejecuta «smartguard reprotect»): ${missing[*]}"
    fi
    rm -rf "$before"
    ok "Restauración completada. Comprueba: sudo smartguard status"
    log "Los vhosts de la copia están en el archivo (carpeta vhosts/) como referencia; el /etc/nginx completo, en nginx-full.tar.gz."
    log "Si este es OTRO servidor: revisa en $SG_ENV los datos de Redis y la IP del servidor en la lista blanca (sudo smartguard allowlist)."
    rm -rf "$work"
    ;;

  protected)
    [ -s "$SG_PROTECTED" ] && cat "$SG_PROTECTED" || log "Ningún sitio registrado con «smartguard protect»."
    ;;

  reprotect)
    tool=$SG_OPT/dist/nginx/vhost-cli.js
    [ -f "$tool" ] || die "Falta $tool (actualiza SmartGuard)."
    [ -s "$SG_PROTECTED" ] || exit 0
    failed_dir=$SG_VAR/reprotect-failed
    todo=()
    while IFS= read -r s; do
      [[ "$s" =~ ^[A-Za-z0-9._-]+$ ]] || continue
      f=$NGX_DIR/sites-enabled/$s.conf
      [ -f "$f" ] || continue
      rc=0; "$NODE" "$tool" protect --dry-run "$f" >/dev/null 2>&1 || rc=$?
      [ "$rc" -eq 0 ] || continue   # 2 = ya está protegido
      # Si con este mismo contenido Nginx ya rechazó los include, no se reintenta en bucle
      sum=$(sha256sum "$f" | cut -d' ' -f1)
      if [ "$(cat "$failed_dir/$s" 2>/dev/null)" = "$sum" ]; then continue; fi
      todo+=("$s")
    done <"$SG_PROTECTED"
    [ ${#todo[@]} -ge 1 ] || exit 0
    log "Reponiendo la protección en: ${todo[*]}"
    keep=$(mktemp -d)
    for s in "${todo[@]}"; do cp -a "$NGX_DIR/sites-enabled/$s.conf" "$keep/"; done
    apply=()
    for s in "${todo[@]}"; do apply+=("$NGX_DIR/sites-enabled/$s.conf"); done
    if ! "$NODE" "$tool" protect "${apply[@]}" >/dev/null || ! nginx_safe_reload; then
      install -d -m 0755 "$failed_dir"
      for s in "${todo[@]}"; do
        cp -a "$keep/$s.conf" "$NGX_DIR/sites-enabled/$s.conf"
        sha256sum "$keep/$s.conf" | cut -d' ' -f1 >"$failed_dir/$s"
      done
      rm -rf "$keep"
      nginx -t >/dev/null 2>&1 && systemctl reload nginx
      die "Nginx rechazó los include en ${todo[*]}: esos vhosts quedan como estaban (SIN protección). Revísalos con: sudo smartguard protect ${todo[*]} --dry-run"
    fi
    rm -rf "$keep"
    for s in "${todo[@]}"; do rm -f "$failed_dir/$s"; done
    ok "Protección repuesta en: ${todo[*]}"
    ;;

  version)
    echo "SmartGuard $("$NODE" -p "require('$SG_OPT/package.json').version") ($(installed_commit))"
    ;;

  update)
    check=false; force=false; pass=()
    for a in "$@"; do
      case "$a" in
        --check) check=true ;;
        --force) force=true ;;
        --yes|-y) pass+=(--yes) ;;
        *) die "Uso: smartguard update [--check] [--force] [--yes]" ;;
      esac
    done
    command -v git >/dev/null || die "Falta git (apt-get install -y git)."
    repo=$(env_get UPDATE_REPO); repo=${repo:-https://github.com/piero2011/smartguard.git}
    branch=$(env_get UPDATE_BRANCH); branch=${branch:-main}
    [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || die "UPDATE_BRANCH inválido: $branch"
    remote=$(git ls-remote "$repo" "refs/heads/$branch" | cut -f1)
    [[ "$remote" =~ ^[0-9a-f]{40}$ ]] || die "No se pudo consultar $repo ($branch). ¿Hay red? ¿El repositorio es privado?"
    installed=$(installed_commit)
    if [ "$remote" = "$installed" ] && [ "$force" != true ]; then
      ok "Ya tienes la última versión (${remote:0:7}). Nada que actualizar."
      exit 0
    fi
    log "Hay cambios en GitHub: instalado ${installed:0:7} → disponible ${remote:0:7}"
    [ "$check" = true ] && exit 0
    # Copia de trabajo propiedad de root (nunca dentro de directorios que escriba el servicio)
    if [ -d "$SG_SRC/.git" ]; then
      git -C "$SG_SRC" remote set-url origin "$repo"
      git -C "$SG_SRC" fetch --quiet --depth 1 origin "$branch"
      git -C "$SG_SRC" reset --quiet --hard FETCH_HEAD
      git -C "$SG_SRC" clean -qfdx
    else
      rm -rf "$SG_SRC"
      git clone --quiet --depth 1 --branch "$branch" "$repo" "$SG_SRC"
    fi
    [ "$(git -C "$SG_SRC" rev-parse HEAD)" = "$remote" ] || warn "GitHub cambió durante la descarga; se instala lo descargado."
    rm -f "$HDR"
    exec bash "$SG_SRC/scripts/update.sh" "${pass[@]}"
    ;;
  logs) exec journalctl -u smartguard -f ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
