{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "sg",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "baseHref": "/dashboard/",
            "styles": ["src/styles.css"],
            "polyfills": [],
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              },
              "outputHashing": "all",
              "sourceMap": false,
              "budgets": [
                { "type": "initial", "maximumWarning": "400kB", "maximumError": "1MB" }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "dashboard:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
