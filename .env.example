# =============================================================================
# SmartGuard — configuración (en el servidor: /etc/smartguard/smartguard.env, 0640 root:smartguard)
# systemd lo carga con EnvironmentFile=. NUNCA subir este archivo con secretos a un repositorio.
# Los valores vacíos de secretos los genera install.sh (openssl rand -hex 32).
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# --- API local (NUNCA exponer) ------------------------------------------------
PORT=3100
BIND_ADDRESS=127.0.0.1

# Token de la API administrativa / dashboard / CLI (≥ 32 caracteres)
ADMIN_TOKEN=
# Secreto que Nginx envía en X-SmartGuard-Key (≥ 24 caracteres). Debe coincidir con
# /etc/nginx/smartguard/secret.conf (lo sincroniza install.sh / `smartguard nginx-sync`).
DECISION_SHARED_SECRET=

# --- Redis ---------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Usa una DB distinta a la del object cache de WordPress
REDIS_DB=5
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=smartguard:
# Timeout por comando (ms). Si Redis tarda más, la decisión sigue en memoria (fail-open).
REDIS_COMMAND_TIMEOUT_MS=60

# --- Modo ----------------------------------------------------------------------
# true = solo registra WOULD_ALLOW / WOULD_RATE_LIMIT / WOULD_BLOCK (primera instalación: 24-72 h)
AUDIT_MODE=true

# --- Umbrales de score ---------------------------------------------------------
SCORE_OBSERVE=20
SCORE_RATE_LIMIT=40
SCORE_RESTRICT=60
SCORE_BLOCK=80
# Evidencia de alta confianza mínima para banear la IP completa (protección NAT)
STRONG_EVIDENCE_MIN=40
# Puntos que se restan por minuto sin actividad maliciosa
SCORE_DECAY_PER_MINUTE=2

# --- Duración de bans (segundos) por reincidencia --------------------------------
BAN_FIRST=900
BAN_SECOND=3600
BAN_THIRD=21600
BAN_FOURTH=86400
BAN_MAX=604800
# Ban de huella IP+User-Agent (señales de baja confianza)
FP_BAN_SEC=600
# Cuánto se recuerda la reincidencia
RECIDIVISM_TTL_SEC=1209600

# --- RATE_LIMIT / RESTRICTION aplicados por SmartGuard ----------------------------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=60
RESTRICT_MAX=15

# --- Reputación / memoria ------------------------------------------------------
IPV6_PREFIX=64
IP_TTL_SEC=3600
FP_TTL_SEC=1800
SCAN_BURST_WINDOW_SEC=60
SCAN_BURST_THRESHOLD=4
SCAN_BURST_BONUS=20
REASONS_MAX=50
EVENTS_STREAM_MAXLEN=20000

# --- Allowlists (separadas por coma). Nunca por User-Agent. ----------------------
# Cada valor puede ser:
#   IP o CIDR              203.0.113.36, 2001:db8::/48
#   dominio exacto         app.customily.com   → se resuelve a sus IPs (refresco ALLOW_DOMAIN_REFRESH_SEC)
#   subdominios            *.customily.com     → verificación FCrDNS (PTR + resolución directa), solo
#                                                cuando la petición es sospechosa; solo en SmartGuard
ADMIN_ALLOWLIST=
SERVICE_ALLOWLIST=
TRUSTED_NETWORKS=
# Sitios/subdominios DESTINO que SmartGuard no puntúa (APIs internas, paneles). Ej.:
#   ALLOW_HOSTS=apicustomizer.orleansembroidery.com,*.dev.orleansembroidery.com
ALLOW_HOSTS=
ALLOW_DOMAIN_REFRESH_SEC=600

# --- Archivos ------------------------------------------------------------------
CONFIG_DIR=/etc/smartguard
CLOUDFLARE_IPS_FILE=/etc/smartguard/cloudflare-ips.txt

# --- Analizador de logs (solo UNA instancia debe tenerlo activo) -----------------
ANALYZER_ENABLED=true
ANALYZER_LOG_PATH=/var/log/nginx/smartguard/access.json
ANALYZER_STATE_FILE=/var/lib/smartguard/analyzer.state

# --- nftables (desactivado por defecto; requiere drop-in systemd con CAP_NET_ADMIN) ---
ENABLE_NFTABLES=false
NFT_BINARY=/usr/sbin/nft

# --- Cloudflare API (opcional) ---------------------------------------------------
ENABLE_CLOUDFLARE=false
# Token con permiso "Account Firewall Access Rules: Edit" (o Zone > Firewall Services: Edit)
CLOUDFLARE_API_TOKEN=
# Si se define, las reglas aplican a TODAS las zonas de la cuenta (recomendado)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_MIN_SCORE=100
CLOUDFLARE_MIN_BAN_COUNT=2
CLOUDFLARE_MAX_ACTIVE_RULES=200
CLOUDFLARE_MAX_PER_HOUR=30

# --- Verificación de bots (FCrDNS) -----------------------------------------------
DNS_TIMEOUT_MS=1500
DNS_POSITIVE_TTL_SEC=86400
DNS_NEGATIVE_TTL_SEC=21600
DNS_CONCURRENCY=4
FAKE_BOT_SCORE=15

# --- Opcionales ------------------------------------------------------------------
ENABLE_GEOIP=false
ENABLE_PROMETHEUS=true
ENABLE_DASHBOARD=true

# --- Alertas (opcional). Webhook HTTPS compatible Slack/Discord --------------------
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=critical
ALERT_MAX_PER_HOUR=30
