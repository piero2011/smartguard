{
  "name": "smartguard",
  "version": "1.14.1",
  "description": "SmartGuard: capa de decisión de seguridad para WordPress/WooCommerce/Multisite delante de PHP-FPM (Nginx auth_request + análisis de logs + Redis).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "build:dashboard": "cd dashboard && npm ci --no-audit --no-fund && npx ng build",
    "build:all": "npm run build && npm run build:dashboard"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prometheus-io/client": "^0.16.1",
    "ioredis": "^5.4.0",
    "ipaddr.js": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
